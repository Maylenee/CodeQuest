# === EdgeOne Makers Model Gateway ===
# Otomatis di-inject platform saat deploy dari template; untuk dev lokal, ambil
# dari Console > Makers > Models > API Key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
# Model yang dipakai tutor (gratis untuk prototyping sesuai kuota bawaan Makers)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# === Turso Database (materi, progress belajar) ===
# Dari `turso db show <db-name> --url` dan `turso db tokens create <db-name>`
TURSO_DATABASE_URL=libsql://codelearn-xxxx.turso.io
TURSO_AUTH_TOKEN=

# Diisi otomatis di production oleh EdgeOne Makers, kosongkan saat dev lokal
NODE_ENV=development
